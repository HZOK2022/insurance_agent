# 复制为 .env 并填入真实值(.env 不入库)
# ===== LLM =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=32768
# ===== Embedding =====
# 嵌入后端:local=本地 sentence-transformers bge(默认);api=SiliconFlow /v1/embeddings(在线,不占本地 CPU)
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=D:\path\to\bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIM=1024
# —— 在线 embedding(EMBEDDING_BACKEND=api 时生效) ——
EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_API_MODEL=BAAI/bge-large-zh-v1.5
# 留空则自动复用 RERANKING_EXTERNAL_API_KEY(SiliconFlow 同一 key)
EMBEDDING_API_KEY=
EMBEDDING_API_TIMEOUT_SECONDS=30
# ===== 文档切块 =====
TEXT_SPLITTER=character
# pdf/docx/xlsx 解析后端:auto(回退链)| mineru | markitdown | pdfplumber | native(仅 docx/xlsx)
PARSER_BACKEND=auto
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# embedding token 预算(bge-large-zh=512;默认 460 含前缀余量;换 bge-m3/8192 改大)
CHUNK_MAX_TOKENS=460
# ===== 检索 =====
TOP_K=20
TOP_K_RERANKER=3
RELEVANCE_THRESHOLD=0.0
HYBRID_BM25_WEIGHT=0.5
# ===== 重排 =====
RERANKING_ENGINE=external
RERANKING_EXTERNAL_URL=https://api.siliconflow.cn/v1/rerank
RERANKING_EXTERNAL_API_KEY=
RERANKING_EXTERNAL_MODEL=BAAI/bge-reranker-v2-m3
RERANKING_EXTERNAL_TIMEOUT=30
RERANKING_MAX_LENGTH=512
# ===== 存储(与其它项目隔离) =====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=insurance_knowledge
REDIS_URL=redis://:password@host:6379/2
SQLITE_PATH=data/agent.db
# ===== MinerU 在线精准解析 API(v4;留空=用 MarkItDown/pdfplumber)=====
MINERU_API_KEY=
MINERU_MODEL_VERSION=vlm
MINERU_TIMEOUT_SECONDS=300
MINERU_POLL_INTERVAL=3
# ===== 记忆(可插拔,默认关)=====
MEMORY_ENABLED=false
# ===== 鉴权(登录/接口)=====
API_TOKEN=
LOGIN_USER=admin
LOGIN_PASSWORD=change-me
# ===== 上限/审批 =====
MAX_STEPS_PER_TURN=20
MAX_TOKENS_PER_TURN=16000
TOOL_TIMEOUT_SECONDS=30
MAX_TOOL_RESULT_CHARS=8000
DAILY_TOKEN_BUDGET_PER_USER=200000
WRITE_TOOLS_APPROVAL=auto
APPROVAL_EXEMPT_TOOLS=
INTERNAL_TOKEN=change-me
