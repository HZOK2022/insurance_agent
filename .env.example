# 复制为 .env 并填入真实值(.env 不入库)
# ===== LLM =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=32768
# ===== Embedding =====
EMBEDDING_MODEL=D:\path\to\bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIM=1024
# ===== 文档切块 =====
TEXT_SPLITTER=character
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# ===== 检索 =====
TOP_K=20
TOP_K_RERANKER=3
RELEVANCE_THRESHOLD=0.0
HYBRID_BM25_WEIGHT=0.5
# ===== 重排 =====
RERANKING_ENGINE=external
RERANKING_EXTERNAL_URL=https://api.siliconflow.cn/v1/rerank
RERANKING_EXTERNAL_API_KEY=
RERANKING_EXTERNAL_MODEL=BAAI/bge-reranker-v2-m3
RERANKING_EXTERNAL_TIMEOUT=30
RERANKING_MAX_LENGTH=512
# ===== 存储(与其它项目隔离) =====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=insurance_knowledge
REDIS_URL=redis://:password@host:6379/2
SQLITE_PATH=data/agent.db
# ===== 上限/审批 =====
MAX_STEPS_PER_TURN=20
MAX_TOKENS_PER_TURN=16000
TOOL_TIMEOUT_SECONDS=30
MAX_TOOL_RESULT_CHARS=8000
DAILY_TOKEN_BUDGET_PER_USER=200000
WRITE_TOOLS_APPROVAL=auto
APPROVAL_EXEMPT_TOOLS=
INTERNAL_TOKEN=change-me
