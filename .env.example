# ===== LLM =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Embedding =====
# bge_m3 = 本地(默认,数据不出内网);api = 走 embedding API
EMBEDDING_PROVIDER=bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ===== Qdrant(实现到连接层时填入真实地址) =====
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=insurance_knowledge

# ===== Redis(实现到连接层时填入真实地址) =====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== SQLite =====
SQLITE_PATH=data/agent.db

# ===== 上限(完整结果预算) =====
MAX_STEPS_PER_TURN=20
MAX_TOKENS_PER_TURN=16000
TOOL_TIMEOUT_SECONDS=30
MAX_TOOL_RESULT_CHARS=8000
DAILY_TOKEN_BUDGET_PER_USER=200000

# ===== 审批 =====
# 写入型工具默认审批;逗号分隔的白名单工具可免审批
WRITE_TOOLS_APPROVAL=auto
APPROVAL_EXEMPT_TOOLS=

# ===== 内部鉴权(起步) =====
INTERNAL_TOKEN=change-me
